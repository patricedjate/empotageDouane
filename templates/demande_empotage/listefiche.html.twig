{{ parent() }}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.min.css" />
{% endblock %}
{% block body %}
	
			<div class="col">
				<p>ministere du budget et du
					<br>
					portefeuille de l'etat
					<br>
					<span class="text-center">----------<span>
							<br>
							direction generale des douanes
							<br><span class="text-center">----------<span><br>
									direction des services douaniers 
																																										            du port et des services speciaux
									<br>
									sous direction des service
									<br>
									douaniers du port
									<br><span class="text-center">----------<span><br>
											bureau export</p>
									</div>
