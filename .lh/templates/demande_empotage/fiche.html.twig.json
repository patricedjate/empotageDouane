            "content": "{% extends 'agentdashboardbase.html.twig' %}\n\n{% block title %}Details fiche\n{% endblock %}\n\n{% block body %}\n\t<h1>Details Fiche</h1>\n\n\t<div class=\"container mt-5\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col\">\n\t\t\t\t<p>ministere du budget et du\n\t\t\t\t\t<br>\n\t\t\t\t\tportefeuille de l'etat\n\t\t\t\t\t<br>\n\t\t\t\t\t<span class=\"text-center\">----------<span>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\tdirection generale des douanes\n\t\t\t\t\t\t\t<br><span class=\"text-center\">----------<span><br>\n\t\t\t\t\t\t\t\t\tdirection des services douaniers \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t            du port et des services speciaux\n\t\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\tsous direction des service\n\t\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\tdouaniers du port\n\t\t\t\t\t\t\t\t\t<br><span class=\"text-center\">----------<span><br>\n\t\t\t\t\t\t\t\t\t\t\tbureau export</p>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<img src=\"{{asset(\"assets/img/logoDouane.png\")}}\" class=\"rounded mx-auto d-block\" alt=\"...\" width=\"80px\">\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<p>republique de côte d'ivoire</p>\n\t\t\t\t\t\t\t\t\t\t<p>Union - Discipline - Travail</p>\n\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<hr class=\"mt-0\">\n\t\t\t\t\t\t\t\t<h5 class=\"mb-1\">Informations personnels</h5>\n\t\t\t\t\t\t\t\t<p class=\"mb-3\"></p>\n\t\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">Nom CDA :\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nomCda }}</p>\n\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t</span>\n\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">Nom Exportateur :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nomExportateur }}</span>\n\t\t\t\t\t