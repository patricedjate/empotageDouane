            "content": "{% extends 'chefdashboardbase.html.twig' %}\n\n{% block title %}Details fiche\n{% endblock %}\n\n{% block body %}\n\t<div class=\"row mb-3\">\n\t\t<div class=\"col-2 mt-4\">\n\t\t\t<a href=\"{{ path('app_fiche_index') }}\" class=\"btn btn-warning\">Revenir à la liste</a>\n\t\t</div>\n\t\t<div class=\"col-2  mt-4\">\n\t\t\t<a href=\"{{ path('app_fiche_edit', {'id': fiche.id}) }}\" class=\"btn btn-primary\">Editer</a>\n\t\t</div>\n\t\t<div class=\"col-2 mt-4\">\n\t\t\t{{ include('chef/fiche/_delete_form.html.twig') }}\n\t\t</div>\n\t</div>\n\t<h1>Details Fiche</h1>\n\n\t<div class=\"container mt-5\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col\">\n\t\t\t\t<p>ministere du budget et du\n\t\t\t\t\t<br>\n\t\t\t\t\tportefeuille de l'etat\n\t\t\t\t\t<br>\n\t\t\t\t\t<span class=\"text-center\">----------<span>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\tdirection generale des douanes\n\t\t\t\t\t\t\t<br><span class=\"text-center\">----------<span><br>\n\t\t\t\t\t\t\t\t\tdirection des services douaniers \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t            du port et des services speciaux\n\t\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\tsous direction des service\n\t\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\tdouaniers du port\n\t\t\t\t\t\t\t\t\t<br><span class=\"text-center\">----------<span><br>\n\t\t\t\t\t\t\t\t\t\t\tbureau export</p>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<img src=\"{{asset(\"assets/img/logoDouane.png\")}}\" class=\"rounded mx-auto d-block\" alt=\"...\" width=\"80px\">\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<p>republique de côte d'ivoire</p>\n\t\t\t\t\t\t\t\t\t\t<p>Union - Discipline - Travail</p>\n\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<hr class=\"mt-0\">\n\t\t\t\t\t\t\t\t<h5 class=\"mb-1\">Informations personnels</h5>\n\t\t\t\t\t\t\t\t<p class=\"mb-3\"></p>\n\t\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">Nom CDA :\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nomCda }}</p>\n\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t</span>\n\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">Nom Exportateur :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nomExportateur }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<hr class=\"mt-2\">\n\t\t\t\t\t\t\t<h5 class=\"mb-1\">Informations sur la marchandise</h5>\n\t\t\t\t\t\t\t<p class=\"mb-3\"></p>\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">Nature de la marchandise:\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.natureMarchandise }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tColis marchandise :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.colisMarchandise }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tPoids Net Marchandise :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.poidsNetMarchandise }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tConditionnement Marchandise :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.conditionnementMarchandise }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tLieu Empotage Marchandise :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.lieuEmpotageMarchandise }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<hr class=\"mt-2\">\n\t\t\t\t\t\t\t<h5 class=\"mb-1\">Informations sur le conteneur</h5>\n\t\t\t\t\t\t\t<p class=\"mb-3\"></p>\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tN° Conteneurs :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nconteneurs }}</span>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\tType Tc :\n\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.typeTC }}<span></p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"col\">\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"fs-4\">\n\t\t\t\t\t\t\t\t\t\t\t\tN° Plombs :\n\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"fs-2 fw-bold\">{{ fiche.nplombs }}</span>\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<!--\n<div class=\"container mt-5\">\n\t\t<p class=\"fs-2\">Pièce joint</p>\n\t\t<img src=\"{{ vich_uploader_asset(fiche, 'imageFile') }}\" width=\"1200px\" height=\"700px\">\n\t</div>\n-->\n\t\t\t\t\t\t{% endblock %}\n"
        }
    ]
